# Signing settings for `make keygen` / `make sign`. Copy to .env (gitignored) and adjust.
# Path to the KeePassXC database that holds the release key ($HOME is expanded).
KDBX="$HOME/.keystores/tapover.kdbx"
# Optional: entry name, attachment name and key alias inside the keystore.
#KDBX_ENTRY=tapover-release
#KDBX_ATTACHMENT=tapover-release.p12
#KEY_ALIAS=tapover
