    <string name="setup_title">One more step: unlock TapOver</string>
    <string name="setup_intro">TapOver was installed from an APK file, so Android keeps two of its permissions locked: drawing over apps and accessibility. Unlocking them is a one-time detour: Android first has to refuse once, and only then does it offer the switch to allow it.</string>
    <string name="setup_step1_title">Let Android refuse once</string>
    <string name="setup_step1_body">Open Accessibility and tap \"TapOver overlay\". Android refuses with \"App was denied access\", like below. That\'s expected: tap Close and come back here.</string>
    <string name="setup_step1_button">Open accessibility</string>
    <string name="setup_step2_title">Allow restricted settings</string>
    <string name="setup_step2_body">Open App info, tap ⋮ in the top-right corner, then \"Allow restricted settings\", like below. Confirm if asked, then come back here.</string>
    <string name="setup_step2_button">Open app info</string>
    <string name="setup_step2_alt">No ⋮ menu? Redo step 1</string>
    <string name="setup_step3_title">Turn on the permissions below</string>
    <string name="setup_step3_body">Unlocked. Now tap Enable next to \"Accessibility service\" and Grant next to \"Draw over apps\" below. This card goes away once both are on.</string>
    <string name="setup_overlay_locked">Complete the steps above first: Android blocks this until restricted settings are allowed.</string>
