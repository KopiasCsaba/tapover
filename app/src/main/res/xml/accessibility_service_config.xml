<?xml version="1.0" encoding="utf-8"?>
<!-- TapOver only needs the foreground app's package/class to decide whether to show its
     overlay. It does NOT retrieve window content.
     notificationTimeout=0: the shade's PANE_APPEARED/PANE_DISAPPEARED markers ride on
     back-to-back window-state changes; a non-zero debounce coalesces them and drops the
     PANE_APPEARED, so the overlay would never fade out when the shade opens. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:canRetrieveWindowContent="false"
    android:notificationTimeout="0"
    android:description="@string/accessibility_description" />
